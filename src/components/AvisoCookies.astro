---
// Aviso de cookies. Solo aparece si el sitio tiene GTM; la respuesta se guarda en el navegador y actualiza el consentimiento.
// El enlace "Cookies" del pie (data-cookies) lo vuelve a abrir.
import { GTM_ID } from '../medicion/config';

const activo = GTM_ID && !Astro.url.pathname.startsWith('/editar');
---

{activo && (
  <div class="cookies" data-aviso-cookies hidden>
    <div class="cookies__caja" role="dialog" aria-modal="true" aria-labelledby="cookies-titulo">
      <h2 id="cookies-titulo" class="cookies__titulo">Antes de empezar: acepta las cookies</h2>
      <p>
        Este sitio es el ejemplo de la clase. Si aceptas, lo que hagas aquí queda medido y lo vemos juntos en Google
        Analytics.{" "}
        <a href="/privacidad/#cookies">Ver la política de cookies</a>
      </p>
      <div class="cookies__botones">
        <button class="boton boton--oscuro cookies__aceptar" type="button" data-cookies-respuesta="si">Aceptar cookies</button>
        <button class="boton cookies__rechazar" type="button" data-cookies-respuesta="no">Rechazar</button>
      </div>
    </div>
  </div>
)}

<script>
  const aviso = document.querySelector<HTMLElement>('[data-aviso-cookies]');
  if (aviso) {
    let guardado: string | null = null;
    try { guardado = localStorage.getItem('cookies'); } catch {}
    const abrir = () => {
      aviso.hidden = false;
      aviso.querySelector<HTMLButtonElement>('.cookies__aceptar')?.focus();
    };
    if (!guardado) abrir();

    aviso.querySelectorAll<HTMLButtonElement>('[data-cookies-respuesta]').forEach((boton) => {
      boton.addEventListener('click', () => {
        const acepta = boton.dataset.cookiesRespuesta === 'si';
        try { localStorage.setItem('cookies', acepta ? 'si' : 'no'); } catch {}
        const permiso = acepta ? 'granted' : 'denied';
        window.dataLayer = window.dataLayer || [];
        // Igual que gtag(): GTM solo reconoce los comandos de consentimiento si llegan como "arguments".
        const gtag = function (..._: unknown[]) { window.dataLayer.push(arguments as unknown as Record<string, unknown>); };
        gtag('consent', 'update', {
          analytics_storage: permiso,
          ad_storage: permiso,
          ad_user_data: permiso,
          ad_personalization: permiso,
        });
        window.dataLayer.push({ event: 'cookies_respondidas', cookies: acepta ? 'si' : 'no' });
        aviso.hidden = true;
      });
    });

    document.querySelectorAll('[data-cookies]').forEach((enlace) => {
      enlace.addEventListener('click', (evento) => {
        evento.preventDefault();
        abrir();
      });
    });
  }
</script>
