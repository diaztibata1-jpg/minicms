---
import Sencilla from '../layouts/Sencilla.astro';
---

<Sencilla titulo="Página no encontrada">
  <section class="sencilla__mensaje">
    <span class="seccion__numero">Error 404</span>
    <h1>Esta página no existe.</h1>
    <p>Puede que el enlace esté mal escrito o que la página ya no esté disponible.</p>
    <div class="sencilla__acciones">
      <a class="boton boton--oscuro" href="/">Volver al inicio</a>
    </div>
  </section>
</Sencilla>
