---
// Clase de SEO, parte 1: SEO técnico del sitio con la evidencia real.
// Los bloques "En vivo" leen la página principal, robots.txt y sitemap.xml desde el navegador, así nunca se desactualizan.
// Queda fuera del sitemap y con noindex: es material de clase, no contenido del negocio.
// Eventos de la clase (data-evento): ir_al_tema, ver_archivo, abrir_herramienta, marcar_punto, cambiar_cookies, leer_completo.
import Sencilla from '../../layouts/Sencilla.astro';
import { GTM_ID } from '../../medicion/config';
import '../../styles/clase.css';

const sitio = new URL('/', Astro.site).href;
const dominio = new URL(sitio).host;
const u = encodeURIComponent(sitio);
const pruebas = {
  ricos: `https://search.google.com/test/rich-results?url=${u}`,
  schema: `https://validator.schema.org/#url=${u}`,
  pagespeed: `https://pagespeed.web.dev/analysis?url=${u}&form_factor=mobile`,
  og: `https://www.opengraph.xyz/url/${u}`,
  facebook: `https://developers.facebook.com/tools/debug/?q=${u}`,
  checkup: 'https://seositecheckup.com/',
  site: `https://www.google.com/search?q=${encodeURIComponent(`site:${dominio}`)}`,
  searchConsole: 'https://search.google.com/search-console',
  tagAssistant: 'https://tagassistant.google.com/',
};

const temas = [
  ['robots', 'robots.txt'],
  ['sitemap', 'sitemap.xml'],
  ['canonical', 'canonical y noindex'],
  ['snippet', 'Título y descripción'],
  ['compartir', 'Open Graph'],
  ['datos', 'Datos estructurados'],
  ['favicon', 'Favicon'],
  ['lighthouse', 'Lighthouse y velocidad'],
  ['html', 'HTML claro'],
  ['auditoria-externa', 'SEO Site Checkup'],
  ['search-console', 'Search Console'],
  ['medicion', 'Medir con permiso'],
];

const lista = [
  '¿Abre /robots.txt y no bloquea páginas importantes?',
  '¿Tiene /sitemap.xml con solo páginas indexables?',
  '¿Cada página tiene canonical, y las que no aportan llevan noindex?',
  '¿Título y descripción propios en cada página, sin cortarse?',
  '¿Se ve bien al compartirlo por WhatsApp?',
  '¿Pasa la prueba de resultados enriquecidos sin errores?',
  '¿Tiene favicon propio en todos los tamaños?',
  '¿Cuánto saca en Lighthouse o PageSpeed en móvil?',
  '¿Idioma declarado, un solo h1, imágenes con alt?',
  '¿Está verificado en Search Console con el sitemap enviado?',
  '¿Mide visitas y contactos, y pide permiso antes de usar cookies?',
];
---

<Sencilla titulo="Clase de SEO · Parte 1: técnico">
  <article class="clase">
    <a class="clase__miga" href="/clase-seo">Clase de SEO</a>
    <span class="seccion__numero">Parte 1 de 2 · SEO técnico</span>
    <h1>Que Google pueda entrar, entender y mostrar el sitio</h1>
    <p class="clase__intro">
      El SEO técnico revisa la base: que el buscador pueda rastrear el sitio, sepa qué indexar, entienda de qué
      negocio se trata y que la página cargue rápido. Todo lo de esta página está aplicado en
      <a href="/" data-evento="ver_archivo" data-evento-seccion="inicio">el sitio de ejemplo</a>, y cada bloque
      <strong>En vivo</strong> lo lee en este momento: no es una captura.
    </p>
    <p class="clase__aviso">
      <strong>Ojo:</strong> nada de esto garantiza el primer lugar en Google. El SEO técnico quita obstáculos; el
      posicionamiento depende además del contenido, que es la <a href="/clase-seo/contenido">parte 2</a>.
    </p>

    <nav class="clase__indice" aria-label="Temas">
      <ol>
        {temas.map(([id, nombre]) => (
          <li><a href={`#${id}`} data-evento="ir_al_tema" data-evento-seccion={id}>{nombre}</a></li>
        ))}
      </ol>
    </nav>

    <section class="tema" id="robots">
      <span class="tema__numero">01</span>
      <h2>robots.txt: qué puede revisar el buscador</h2>
      <p>
        Es lo primero que lee un rastreador al llegar a un dominio. Le dice qué rutas no debe revisar y dónde está
        el mapa del sitio. Aquí bloqueamos solo <code>/editar</code>, el editor del cliente.
      </p>
      <p class="tema__nota">
        robots.txt no esconde nada: una página bloqueada aún puede aparecer en Google si alguien la enlaza. Para sacar
        una página de los resultados se usa <code>noindex</code> (tema 03).
      </p>
      <div class="vivo">
        <span class="vivo__etiqueta">En vivo · /robots.txt</span>
        <pre data-vivo="robots">Cargando…</pre>
      </div>
      <div class="tema__acciones">
        <a class="boton sencilla__volver" href="/robots.txt" target="_blank" rel="noopener" data-evento="ver_archivo" data-evento-seccion="robots">Abrir robots.txt</a>
      </div>
    </section>

    <section class="tema" id="sitemap">
      <span class="tema__numero">02</span>
      <h2>sitemap.xml: la lista de páginas que queremos en Google</h2>
      <p>
        Un archivo XML con las direcciones que sí deben indexarse. Se genera solo al publicar, tomando el dominio de
        la configuración, así no hay que mantenerlo a mano. Solo lleva páginas indexables: la página de gracias,
        la política de datos, el 404, el editor y esta clase quedan fuera.
      </p>
      <div class="vivo">
        <span class="vivo__etiqueta">En vivo · /sitemap.xml</span>
        <pre data-vivo="sitemap">Cargando…</pre>
      </div>
      <div class="tema__acciones">
        <a class="boton sencilla__volver" href="/sitemap.xml" target="_blank" rel="noopener" data-evento="ver_archivo" data-evento-seccion="sitemap">Abrir sitemap.xml</a>
      </div>
    </section>

    <section class="tema" id="canonical">
      <span class="tema__numero">03</span>
      <h2>canonical y noindex: una dirección por página</h2>
      <p>
        Una misma página puede abrirse con varias direcciones (con o sin barra final, con parámetros de campañas
        como <code>?utm_source=instagram</code>). La etiqueta <code>canonical</code> le dice a Google cuál es la
        oficial para que no las trate como copias. Las páginas que no aportan en una búsqueda llevan
        <code>noindex, follow</code>: no salen en resultados, pero Google sí sigue sus enlaces.
      </p>
      <div class="vivo">
        <span class="vivo__etiqueta">En vivo · etiqueta de cada página</span>
        <table class="vivo__tabla">
          <thead><tr><th>Página</th><th>Qué le dice a Google</th></tr></thead>
          <tbody data-vivo="indexacion"><tr><td colspan="2">Cargando…</td></tr></tbody>
        </table>
      </div>
    </section>

    <section class="tema" id="snippet">
      <span class="tema__numero">04</span>
      <h2>Título y descripción: lo que se ve en el resultado</h2>
      <p>
        El <code>&lt;title&gt;</code> y la <code>meta description</code> son lo que normalmente muestra Google en la
        lista de resultados. La descripción no sube posiciones, pero decide si la persona hace clic. La escribimos
        para cada negocio, entre 50 y 155 caracteres, con qué es, dónde está y qué hacer.
      </p>
      <p class="tema__nota">
        Google puede reescribir los dos si cree que otro texto de la página responde mejor la búsqueda. Qué palabras
        poner en el título es tema de la <a href="/clase-seo/contenido#pagina">parte 2</a>.
      </p>
      <div class="vivo">
        <span class="vivo__etiqueta">En vivo · así se vería en Google (aproximado)</span>
        <div class="serp">
          <div class="serp__sitio">
            <img class="serp__icono" src="/favicon.svg" alt="" width="26" height="26" />
            <div><span class="serp__nombre" data-serp="nombre">…</span><span class="serp__url" data-serp="url">…</span></div>
          </div>
          <p class="serp__titulo" data-serp="titulo">…</p>
          <p class="serp__descripcion" data-serp="descripcion">…</p>
        </div>
        <p class="vivo__medidas" data-vivo="medidas"></p>
      </div>
    </section>

    <section class="tema" id="compartir">
      <span class="tema__numero">05</span>
      <h2>Open Graph: cómo se ve al compartir en WhatsApp o Facebook</h2>
      <p>
        No es SEO de Google, pero para un negocio pequeño pesa igual: mucho del tráfico llega por enlaces
        compartidos. Las etiquetas <code>og:</code> definen título, descripción e imagen de la vista previa. La
        imagen de 1200×630 se genera sola al publicar con el nombre, el titular y la foto principal, y pesa menos
        de 300 KB porque WhatsApp no muestra imágenes más pesadas.
      </p>
      <div class="vivo">
        <span class="vivo__etiqueta">En vivo · /og.jpg y etiquetas</span>
        <img class="vivo__imagen" src="/og.jpg" alt="Imagen que aparece al compartir el sitio" width="1200" height="630" loading="lazy" />
        <pre data-vivo="og">Cargando…</pre>
      </div>
      <div class="tema__acciones">
        <a class="boton sencilla__volver" href={pruebas.og} target="_blank" rel="noopener" data-evento="abrir_herramienta" data-evento-seccion="opengraph">Ver vista previa (OpenGraph.xyz)</a>
        <a class="boton sencilla__volver" href={pruebas.facebook} target="_blank" rel="noopener" data-evento="abrir_herramienta" data-evento-seccion="facebook_debugger">Depurador de Facebook</a>
      </div>
    </section>

    <section class="tema" id="datos">
      <span class="tema__numero">06</span>
      <h2>Datos estructurados: decirle a Google qué es el negocio</h2>
      <p>
        Un bloque JSON-LD con el vocabulario de schema.org le dice a Google, sin adivinar, que esto es un
        <code>LocalBusiness</code> con nombre, teléfono, dirección y ciudad. Va solo en la página principal y se
        llena con los mismos datos que el cliente edita, así nunca contradice lo que dice la página.
      </p>
      <p class="tema__nota">
        Los datos estructurados hacen a la página elegible para resultados más completos; Google decide si los
        muestra. Para aparecer en Maps lo que cuenta es el Perfil de Empresa de Google (parte 2).
      </p>
      <div class="vivo">
        <span class="vivo__etiqueta">En vivo · JSON-LD de la página principal</span>
        <pre data-vivo="jsonld">Cargando…</pre>
      </div>
      <div class="tema__acciones">
        <a class="boton boton--oscuro" href={pruebas.ricos} target="_blank" rel="noopener" data-evento="abrir_herramienta" data-evento-seccion="resultados_enriquecidos">Prueba de resultados enriquecidos</a>
        <a class="boton sencilla__volver" href={pruebas.schema} target="_blank" rel="noopener" data-evento="abrir_herramienta" data-evento-seccion="validador_schema">Validador de schema.org</a>
      </div>
    </section>

    <section class="tema" id="favicon">
      <span class="tema__numero">07</span>
      <h2>Favicon: el ícono que sale junto al resultado</h2>
      <p>
        Google muestra el favicon al lado del nombre del sitio en los resultados del celular, y el navegador lo usa
        en pestañas, favoritos y al guardar el sitio en la pantalla de inicio. Cada uso pide un tamaño distinto, así
        que se generan todos a partir del mismo logo al publicar.
      </p>
      <ul class="tema__lista">
        <li><code>favicon.svg</code>: vectorial, nítido en cualquier tamaño. Google pide un ícono cuadrado de 48 px o múltiplo; el SVG lo cumple.</li>
        <li><code>favicon.ico</code> de 32 px: para navegadores viejos y para quien lo pida en la raíz.</li>
        <li><code>apple-touch-icon.png</code> de 180 px: al guardar el sitio en un iPhone.</li>
        <li><code>manifest.webmanifest</code> con íconos de 192 y 512 px y <code>theme-color</code>: en Android, el color de la barra y el ícono de la app.</li>
      </ul>
      <div class="vivo">
        <span class="vivo__etiqueta">En vivo · íconos declarados en la página principal</span>
        <div class="iconos" data-vivo="iconos">Cargando…</div>
      </div>
    </section>

    <section class="tema" id="lighthouse">
      <span class="tema__numero">08</span>
      <h2>Lighthouse y velocidad: 100 en las cuatro categorías</h2>
      <p>
        Lighthouse es la auditoría de Google que viene en Chrome. Califica de 0 a 100 rendimiento, accesibilidad,
        buenas prácticas y SEO. Google además mide la experiencia real con las Core Web Vitals: cuánto tarda en
        verse lo principal (LCP), si la página salta mientras carga (CLS) y qué tan rápido responde a un toque (INP).
        Este sitio sacó 100 en las cuatro categorías en móvil.
      </p>
      <ol class="tema__lista">
        <li>En Chrome, abre el sitio en una ventana de incógnito (las extensiones bajan el puntaje).</li>
        <li>Clic derecho &gt; Inspeccionar &gt; pestaña <strong>Lighthouse</strong>.</li>
        <li>Elige <strong>Mobile</strong>, marca las cuatro categorías y pulsa <strong>Analyze page load</strong>.</li>
      </ol>
      <p>Qué hicimos para llegar a 100:</p>
      <ul class="tema__lista">
        <li>HTML estático: no hay servidor armando la página en cada visita.</li>
        <li>Imágenes en WebP, del tamaño justo y con ancho y alto fijos para que nada salte al cargar.</li>
        <li>Casi nada de JavaScript; la medición (Tag Manager) se carga sin bloquear la página.</li>
        <li>Contraste de colores y textos alternativos revisados: la accesibilidad también cuenta.</li>
      </ul>
      <p class="tema__nota">
        PageSpeed Insights corre la misma prueba desde los servidores de Google, así que el número puede variar unos
        puntos entre una corrida y otra. Pruébenlo con la página principal: esta página de la clase tiene
        <code>noindex</code> a propósito, y Lighthouse le baja la nota de SEO por eso.
      </p>
      <div class="tema__acciones">
        <a class="boton boton--oscuro" href={pruebas.pagespeed} target="_blank" rel="noopener" data-evento="abrir_herramienta" data-evento-seccion="pagespeed">Correr PageSpeed Insights</a>
      </div>
    </section>

    <section class="tema" id="html">
      <span class="tema__numero">09</span>
      <h2>HTML claro: idioma, un solo h1 y textos alternativos</h2>
      <p>
        Lo básico que más se olvida: declarar el idioma, tener un solo título principal, describir las imágenes y
        preparar la página para el celular.
      </p>
      <div class="vivo">
        <span class="vivo__etiqueta">En vivo · revisión de la página principal</span>
        <ul class="revision" data-vivo="html"><li>Cargando…</li></ul>
      </div>
    </section>

    <section class="tema" id="auditoria-externa">
      <span class="tema__numero">10</span>
      <h2>Una segunda opinión: SEO Site Checkup</h2>
      <p>
        Herramientas como SEO Site Checkup revisan de una vez decenas de puntos: título, descripción, encabezados,
        imágenes, robots, sitemap, velocidad, seguridad y más, y entregan una nota con lo que falta. Sirven para
        auditar un sitio ajeno en minutos o para no olvidar nada en uno propio.
      </p>
      <ol class="tema__lista">
        <li>Abre SEO Site Checkup y pega la dirección del sitio: <code>{sitio}</code></li>
        <li>Revisa primero los puntos en rojo: son los que más pesan.</li>
        <li>Compara con lo que vimos aquí: varias alertas se explican con los temas 01 a 09.</li>
      </ol>
      <p class="tema__nota">
        La versión gratuita tiene un número limitado de análisis. Su nota es una guía, no la de Google: no todas sus
        alertas cambian el posicionamiento.
      </p>
      <div class="tema__acciones">
        <a class="boton boton--oscuro" href={pruebas.checkup} target="_blank" rel="noopener" data-evento="abrir_herramienta" data-evento-seccion="seositecheckup">Abrir SEO Site Checkup</a>
      </div>
    </section>

    <section class="tema" id="search-console">
      <span class="tema__numero">11</span>
      <h2>Search Console: la conversación directa con Google</h2>
      <p>
        Es la herramienta gratuita de Google para el dueño del sitio. Primero se demuestra que el sitio es nuestro
        (aquí con un archivo de verificación), luego se envía el sitemap y desde ahí se ve qué páginas están
        indexadas y qué errores encontró Google. Su informe de rendimiento (búsquedas, apariciones y clics) se
        usa en la parte 2.
      </p>
      <ul class="tema__lista">
        <li>Verificación: archivo <a href="/google291f5c89723064e1.html" target="_blank" rel="noopener" data-evento="ver_archivo" data-evento-seccion="verificacion">google291f5c89723064e1.html</a> en la raíz.</li>
        <li>Sitemap enviado desde Search Console.</li>
        <li>Los datos tardan días en aparecer; un sitio nuevo no sale en Google de inmediato.</li>
      </ul>
      <div class="tema__acciones">
        <a class="boton sencilla__volver" href={pruebas.searchConsole} target="_blank" rel="noopener" data-evento="abrir_herramienta" data-evento-seccion="search_console">Abrir Search Console</a>
        <a class="boton sencilla__volver" href={pruebas.site} target="_blank" rel="noopener" data-evento="abrir_herramienta" data-evento-seccion="busqueda_site">Buscar site:{dominio}</a>
      </div>
    </section>

    <section class="tema" id="medicion">
      <span class="tema__numero">12</span>
      <h2>Medir con permiso: Tag Manager, Analytics y cookies</h2>
      {GTM_ID ? (
        <>
          <p>
            Sin medir no se sabe si algo funcionó. El sitio carga Google Tag Manager con el modo de consentimiento:
            hasta que la persona acepta en el aviso, no se guardan cookies de medición. Desde Tag Manager se
            administran Google Analytics 4 y Clarity sin tocar el código. Los botones de esta clase también envían
            eventos: si aceptan las cookies, lo que hagan aquí aparece en Analytics en segundos.
          </p>
          <div class="vivo">
            <span class="vivo__etiqueta">En vivo · en este navegador</span>
            <ul class="revision" data-vivo="medicion"><li>Cargando…</li></ul>
          </div>
          <div class="tema__acciones">
            <a class="boton sencilla__volver" href="/politica-de-datos#cookies" data-cookies data-evento="cambiar_cookies" data-evento-seccion="tecnico">Cambiar mi respuesta de cookies</a>
            <a class="boton sencilla__volver" href={pruebas.tagAssistant} target="_blank" rel="noopener" data-evento="abrir_herramienta" data-evento-seccion="tag_assistant">Tag Assistant</a>
          </div>
        </>
      ) : (
        <p>Este sitio no tiene medición configurada.</p>
      )}
    </section>

    <section class="tema tema--cierre" data-final="tecnico">
      <h2>Lista para auditar cualquier sitio</h2>
      <ul class="auditoria">
        {lista.map((punto, i) => (
          <li>
            <label>
              <input type="checkbox" data-evento="marcar_punto" data-evento-seccion={`tecnico_${i + 1}`} />
              <span>{punto}</span>
            </label>
          </li>
        ))}
      </ul>
      <div class="tema__acciones">
        <a class="boton boton--oscuro" href="/clase-seo/contenido" data-evento="elegir_tema" data-evento-seccion="contenido">Seguir con la parte 2: contenido</a>
      </div>
    </section>
  </article>
</Sencilla>

<script>
  import { medirFinal } from '../../scripts/clase';
  medirFinal();

  const ponerTexto = (clave: string, texto: string) => {
    const caja = document.querySelector<HTMLElement>(`[data-vivo="${clave}"]`);
    if (caja) caja.textContent = texto;
  };

  const leer = async (ruta: string) => {
    const respuesta = await fetch(ruta, { cache: 'no-store' });
    if (!respuesta.ok) throw new Error(`${ruta}: ${respuesta.status}`);
    return respuesta.text();
  };

  const leerHtml = async (ruta: string) => new DOMParser().parseFromString(await leer(ruta), 'text/html');

  const fila = (pagina: string, texto: string) => {
    const tr = document.createElement('tr');
    for (const valor of [pagina, texto]) {
      const td = document.createElement('td');
      td.textContent = valor;
      tr.append(td);
    }
    return tr;
  };

  const punto = (ok: boolean, texto: string) => {
    const li = document.createElement('li');
    li.className = ok ? 'revision__ok' : 'revision__falta';
    li.textContent = texto;
    return li;
  };

  const indexacion = (doc: Document) => {
    const robots = doc.querySelector('meta[name="robots"]')?.getAttribute('content');
    if (robots) return `robots: ${robots}`;
    const canonica = doc.querySelector('link[rel="canonical"]')?.getAttribute('href');
    return canonica ? `canonical: ${canonica}` : 'Sin canonical ni robots';
  };

  leer('/robots.txt').then((t) => ponerTexto('robots', t.trim())).catch(() => ponerTexto('robots', 'No se pudo leer.'));
  leer('/sitemap.xml').then((t) => ponerTexto('sitemap', t.trim())).catch(() => ponerTexto('sitemap', 'No se pudo leer.'));

  const rutas = ['/', '/politica-de-datos', '/gracias', '/clase-seo/tecnico'];
  Promise.all(rutas.map((ruta) => (ruta === '/clase-seo/tecnico' ? Promise.resolve(document) : leerHtml(ruta))))
    .then((docs) => {
      const cuerpo = document.querySelector('[data-vivo="indexacion"]');
      cuerpo?.replaceChildren(...docs.map((doc, i) => fila(rutas[i], indexacion(doc))));
    })
    .catch(() => document.querySelector('[data-vivo="indexacion"]')?.replaceChildren(fila('—', 'No se pudo leer.')));

  leerHtml('/')
    .then((doc) => {
      const meta = (selector: string) => doc.querySelector(selector)?.getAttribute('content') ?? '';
      const titulo = doc.title;
      const descripcion = meta('meta[name="description"]');
      const canonica = doc.querySelector('link[rel="canonical"]')?.getAttribute('href') ?? location.origin;

      const serp = (campo: string, texto: string) => {
        const nodo = document.querySelector(`[data-serp="${campo}"]`);
        if (nodo) nodo.textContent = texto;
      };
      serp('nombre', meta('meta[property="og:site_name"]'));
      serp('url', canonica);
      serp('titulo', titulo.length > 60 ? `${titulo.slice(0, 57)}…` : titulo);
      serp('descripcion', descripcion.length > 155 ? `${descripcion.slice(0, 152)}…` : descripcion);
      ponerTexto('medidas', `Título: ${titulo.length} caracteres (se recomienda hasta ~60). Descripción: ${descripcion.length} caracteres (se recomienda 50 a 155).`);

      const og = [...doc.querySelectorAll('meta[property^="og:"], meta[name^="twitter:"]')]
        .map((m) => `<meta ${m.hasAttribute('property') ? 'property' : 'name'}="${m.getAttribute('property') ?? m.getAttribute('name')}" content="${m.getAttribute('content')}">`)
        .join('\n');
      ponerTexto('og', og || 'No hay etiquetas Open Graph.');

      const bloque = doc.querySelector('script[type="application/ld+json"]')?.textContent;
      ponerTexto('jsonld', bloque ? JSON.stringify(JSON.parse(bloque), null, 2) : 'No hay datos estructurados.');

      // Íconos: se muestran tal como los pide la página, con su tamaño declarado.
      const iconos = [...doc.querySelectorAll<HTMLLinkElement>('link[rel="icon"], link[rel="apple-touch-icon"]')].map((link) => {
        const figura = document.createElement('figure');
        const img = document.createElement('img');
        img.src = link.getAttribute('href') ?? '';
        img.alt = '';
        img.width = 48;
        img.height = 48;
        const pie = document.createElement('figcaption');
        pie.textContent = `${link.getAttribute('href')}${link.getAttribute('sizes') ? ` · ${link.getAttribute('sizes')}` : ''}`;
        figura.append(img, pie);
        return figura;
      });
      const color = meta('meta[name="theme-color"]');
      const manifiesto = doc.querySelector('link[rel="manifest"]')?.getAttribute('href');
      const extra = document.createElement('p');
      extra.className = 'iconos__extra';
      extra.textContent = `theme-color: ${color || 'no declarado'} · manifest: ${manifiesto || 'no declarado'}`;
      if (color) extra.style.setProperty('--color-tema', color);
      document.querySelector('[data-vivo="iconos"]')?.replaceChildren(...iconos, extra);

      const imagenes = [...doc.querySelectorAll('img')];
      const sinAlt = imagenes.filter((img) => !img.hasAttribute('alt')).length;
      const h1 = doc.querySelectorAll('h1').length;
      const lang = doc.documentElement.lang;
      const viewport = doc.querySelector('meta[name="viewport"]');
      document.querySelector('[data-vivo="html"]')?.replaceChildren(
        punto(Boolean(lang), lang ? `Idioma declarado: lang="${lang}"` : 'Falta declarar el idioma'),
        punto(h1 === 1, `Títulos h1 en la página: ${h1}`),
        punto(sinAlt === 0, `Imágenes: ${imagenes.length}, sin texto alternativo: ${sinAlt}`),
        punto(Boolean(viewport), viewport ? 'Preparada para celular (meta viewport)' : 'Falta meta viewport'),
      );
    })
    .catch(() => {
      for (const clave of ['og', 'jsonld', 'iconos']) ponerTexto(clave, 'No se pudo leer la página principal.');
    });

  const medicion = document.querySelector('[data-vivo="medicion"]');
  if (medicion) {
    const pintar = () => {
      let respuesta: string | null = null;
      try { respuesta = localStorage.getItem('cookies'); } catch {}
      const gtm = [...document.scripts].some((s) => s.src.includes('googletagmanager.com/gtm.js'));
      const textos: Record<string, string> = {
        si: 'Aceptaste las cookies: Analytics y Clarity están midiendo esta visita.',
        no: 'Rechazaste las cookies: Tag Manager carga, pero no guarda cookies de medición.',
      };
      medicion.replaceChildren(
        punto(gtm, gtm ? 'Google Tag Manager cargado' : 'Google Tag Manager no cargó (¿bloqueador de anuncios?)'),
        punto(respuesta === 'si', respuesta ? textos[respuesta] : 'Aún no respondes el aviso: nada se guarda hasta que aceptes.'),
      );
    };
    pintar();
    document.addEventListener('click', (evento) => {
      if ((evento.target as HTMLElement).closest('[data-cookies-respuesta]')) setTimeout(pintar, 50);
    });
  }
</script>
