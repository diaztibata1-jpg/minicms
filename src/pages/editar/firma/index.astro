---
// Firma de correo lista para copiar y pegar en Gmail u Outlook. Vive dentro de /editar, así que pide la misma contraseña del editor.
// Cada persona ajusta sus datos en el formulario antes de copiar; no se guarda nada, solo arranca con los datos del sitio.
// El logo (/firma/logo.png) sí queda público: Gmail lo carga desde el correo de quien recibe.
// La firma usa tablas y estilos en línea porque los clientes de correo ignoran las hojas de estilo.
import { getCollection } from 'astro:content';
import Sencilla from '../../../layouts/Sencilla.astro';

const [pagina] = await getCollection('paginas');
const contenido = pagina.data;
const persona = contenido.firma;
const sitio = new URL('/', Astro.site);
const logo = new URL('/firma/logo.png', Astro.site).href;
const telefono = contenido.whatsapp.replace(/^57(\d{3})(\d{3})(\d{4})$/, '+57 $1 $2 $3');
const enlace = 'color:#355d4a;text-decoration:none;';
const texto = 'margin:0;font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:20px;color:#59685e;';
const campos: { id: string; etiqueta: string; valor: string; tipo: 'text' | 'tel' | 'email'; maximo: number }[] = [
  { id: 'nombre', etiqueta: 'Nombre', valor: persona.nombre, tipo: 'text', maximo: 60 },
  { id: 'cargo', etiqueta: 'Cargo', valor: persona.cargo, tipo: 'text', maximo: 60 },
  { id: 'telefono', etiqueta: 'WhatsApp', valor: telefono, tipo: 'tel', maximo: 20 },
  { id: 'correo', etiqueta: 'Correo', valor: persona.correo, tipo: 'email', maximo: 120 },
  { id: 'direccion', etiqueta: 'Dirección', valor: contenido.direccion, tipo: 'text', maximo: 160 },
];
---

<Sencilla titulo="Firma de correo">
  <section class="sencilla__mensaje firma">
    <span class="seccion__numero">Firma de correo</span>
    <h1>Arma y copia tu firma</h1>
    <ol class="firma__pasos">
      <li>Cambia tus datos; la firma de abajo se actualiza mientras escribes.</li>
      <li>Toca <strong>Copiar firma</strong>.</li>
      <li>En Gmail: Configuración (rueda) → Ver todos los ajustes → General → Firma → Crear nueva. Pega, elige usarla en correos nuevos y respuestas, y guarda al final de la página.</li>
    </ol>
    <form class="firma__campos" data-firma-campos>
      {campos.map((campo) => (
        <label>
          {campo.etiqueta}
          <input name={campo.id} type={campo.tipo} value={campo.valor} maxlength={campo.maximo} />
        </label>
      ))}
    </form>
    <div class="firma__bloque">
      <div class="firma__vista" id="firma">
        <table cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;">
          <tr>
            <td style="padding:0 16px 0 0;vertical-align:top;">
              <img src={logo} width="64" height="64" alt={contenido.negocio_nombre} style="display:block;border:0;" />
            </td>
            <td style="padding:0 0 0 16px;border-left:3px solid #cf6546;vertical-align:top;">
              <p style="margin:0;font-family:Georgia,'Times New Roman',serif;font-size:18px;line-height:24px;color:#203b32;" data-firma="nombre">{persona.nombre}</p>
              <p style={texto}><span data-firma="cargo">{persona.cargo}</span> · <span style="color:#cf6546;font-weight:bold;">{contenido.negocio_nombre}</span></p>
              <p style={texto}>WhatsApp <a href={`https://wa.me/${contenido.whatsapp}`} style={enlace} data-firma="telefono">{telefono}</a> · <a href={`mailto:${persona.correo}`} style={enlace} data-firma="correo">{persona.correo}</a></p>
              <p style={texto}><a href={sitio.href} style={enlace}>{sitio.host}</a> · <span data-firma="direccion">{contenido.direccion}</span></p>
            </td>
          </tr>
        </table>
      </div>
      <button class="boton boton--oscuro" type="button" data-copiar>Copiar firma</button>
    </div>
  </section>
</Sencilla>

<script>
  const firma = document.getElementById('firma')!;
  const formulario = document.querySelector<HTMLFormElement>('[data-firma-campos]')!;

  // Pasa lo escrito a la firma. Solo se usa textContent y atributos, así que nada de lo escrito se interpreta como HTML.
  const actualizar = () => {
    const datos = new FormData(formulario);
    for (const [campo, valor] of datos) {
      const destino = firma.querySelector<HTMLElement>(`[data-firma="${campo}"]`);
      if (destino) destino.textContent = String(valor).trim();
    }
    const digitos = String(datos.get('telefono')).replace(/\D/g, '');
    // Un celular colombiano de 10 dígitos se completa con el 57 para el enlace de WhatsApp.
    firma.querySelector('[data-firma="telefono"]')!.setAttribute('href', `https://wa.me/${digitos.length === 10 ? `57${digitos}` : digitos}`);
    firma.querySelector('[data-firma="correo"]')!.setAttribute('href', `mailto:${String(datos.get('correo')).trim()}`);
  };
  formulario.addEventListener('input', actualizar);
  formulario.addEventListener('submit', (evento) => evento.preventDefault());

  // Copia la firma con su formato. Si el navegador no deja escribir HTML en el portapapeles, selecciona y copia.
  const boton = document.querySelector<HTMLButtonElement>('[data-copiar]')!;
  boton.addEventListener('click', async () => {
    try {
      await navigator.clipboard.write([new ClipboardItem({
        'text/html': new Blob([firma.innerHTML], { type: 'text/html' }),
        'text/plain': new Blob([firma.innerText], { type: 'text/plain' }),
      })]);
    } catch {
      const rango = document.createRange();
      rango.selectNodeContents(firma);
      const seleccion = window.getSelection()!;
      seleccion.removeAllRanges();
      seleccion.addRange(rango);
      document.execCommand('copy');
      seleccion.removeAllRanges();
    }
    boton.textContent = '¡Copiada! Ahora pégala en Gmail';
    setTimeout(() => (boton.textContent = 'Copiar firma'), 4000);
  });
</script>
