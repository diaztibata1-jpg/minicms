---
// Destino después de enviar el formulario. Sirve para medir conversiones de pauta.
import { getCollection } from 'astro:content';
import Sencilla from '../layouts/Sencilla.astro';

const [pagina] = await getCollection('paginas');
const { whatsapp } = pagina.data;
---

<Sencilla titulo="Gracias">
  <section class="sencilla__mensaje">
    <span class="seccion__numero">Mensaje enviado</span>
    <h1>¡Gracias! Te contactaremos pronto.</h1>
    <p>Recibimos tus datos. Si es urgente, escríbenos por WhatsApp.</p>
    <div class="sencilla__acciones">
      <a class="boton boton--oscuro" href={`https://wa.me/${whatsapp}`}>Escribir por WhatsApp</a>
      <a class="boton sencilla__volver" href="/">Volver al inicio</a>
    </div>
  </section>
</Sencilla>
